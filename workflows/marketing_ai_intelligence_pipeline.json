    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// 1. Валідація обов'язкових полів від біржі\nif (!raw || !raw.lastPrice || !raw.symbol) {\n  throw new Error(\"Validation Error: Binance response is missing required fields (lastPrice, symbol).\");\n}\n\n// 2. Детерміновані числові розрахунки\nconst currentPrice = Number(parseFloat(raw.lastPrice).toFixed(2));\nconst changePercent = Number(parseFloat(raw.priceChangePercent).toFixed(2));\nconst high24h = Number(parseFloat(raw.highPrice).toFixed(2));\nconst low24h = Number(parseFloat(raw.lowPrice).toFixed(2));\nconst volumeBtc = Number(parseFloat(raw.volume).toFixed(2));\n\n// 3. Форматування валюти ($82,105.53)\nconst formatCurrency = (val) => {\n  return '$' + val.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n};\n\n// 4. Поточний час виконання та динамічне визначення часового поясу Чорногорії\nconst now = new Date();\n\n// Форматування дати і часу за Чорногорією\nconst montenegroDate = now.toLocaleString('uk-UA', {\n  timeZone: 'Europe/Podgorica',\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric',\n  hour: '2-digit',\n  minute: '2-digit',\n  hour12: false\n});\n\n// Динамічне визначення зміщення (UTC+2 влітку, UTC+1 взимку)\nconst offsetPart = new Intl.DateTimeFormat('en-US', {\n  timeZone: 'Europe/Podgorica',\n  timeZoneName: 'shortOffset'\n}).formatToParts(now).find(p => p.type === 'timeZoneName');\n\nconst utcOffset = offsetPart ? offsetPart.value.replace('GMT', 'UTC') : 'UTC+2';\nconst formattedDisplayDate = `${montenegroDate} (ME, ${utcOffset})`;\n\n// 5. Повернення структурованого результату\nreturn [{\n  json: {\n    // Сирі дані (для логіки, Google Sheets тощо)\n    symbol: raw.symbol,\n    price: currentPrice,\n    changePercent24h: changePercent,\n    high24h: high24h,\n    low24h: low24h,\n    volumeBTC: volumeBtc,\n    timestampRaw: now.toISOString(),\n    isPositiveTrend: changePercent >= 0,\n\n    // Відформатовані рядки для інтерфейсу\n    displayPrice: formatCurrency(currentPrice),\n    displayHigh: formatCurrency(high24h),\n    displayLow: formatCurrency(low24h),\n    displayVolume: volumeBtc.toLocaleString('en-US', { maximumFractionDigits: 2 }) + ' BTC',\n    displayChange: (changePercent >= 0 ? '+' : '') + changePercent + '%',\n    displayDate: formattedDisplayDate\n  }\n}];"
      },
